{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "topbar",
      "type": "row",
      "children": [
        {
          "id": "bar-left",
          "type": "block",
          "content": {
            "mod": "vectron-bar",
            "props": {
              "part": "left"
            }
          },
          "size": {
            "weight": 3
          }
        },
        {
          "id": "ai-usage",
          "type": "block",
          "content": {
            "mod": "vectron-ai-usage",
            "props": {
              "compact": true
            }
          },
          "size": {
            "weight": 2.5
          }
        },
        {
          "id": "bar-right",
          "type": "block",
          "content": {
            "mod": "vectron-bar",
            "props": {
              "part": "right"
            }
          },
          "size": {
            "px": 0
          }
        }
      ],
      "size": {
        "px": 30
      },
      "background": "chrome",
      "resizable": false,
      "window_drag": true
    },
    {
      "id": "desk",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "vectron-chrome"
              },
              "size": {
                "px": 36
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              },
              "window_drag": true
            },
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "vectron-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "vectron-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90,
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "content": {
                "mod": "vectron-chrome",
                "props": {
                  "footer": true
                }
              },
              "size": {
                "px": 106
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            }
          ],
          "size": {
            "px": 243
          },
          "min": 44,
          "max": 480,
          "gap": 6,
          "resizable": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "vectron-tabs"
              },
              "size": {
                "px": 36
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              }
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "vectron-pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 2,
                        "color": "border"
                      },
                      "focus": {
                        "width": 2,
                        "color": "accent"
                      },
                      "radius": 0,
                      "gap": 6,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "vectron-files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "stack",
                          "children": [
                            {
                              "id": "changes-view",
                              "type": "block",
                              "content": {
                                "mod": "vectron-changes",
                                "props": {
                                  "graph": "git-graph"
                                }
                              }
                            },
                            {
                              "id": "git-graph",
                              "type": "block",
                              "content": {
                                "mod": "vectron-changes",
                                "props": {
                                  "view": "graph",
                                  "back": "changes-view"
                                }
                              }
                            }
                          ],
                          "active": "changes-view"
                        },
                        {
                          "id": "context",
                          "type": "block",
                          "content": {
                            "mod": "vectron-context"
                          }
                        },
                        {
                          "id": "egm",
                          "type": "block",
                          "content": {
                            "mod": "vectron-egm"
                          }
                        },
                        {
                          "id": "browser-notes",
                          "type": "block",
                          "content": {
                            "mod": "vectron-notes"
                          }
                        }
                      ],
                      "active": "context"
                    }
                  ],
                  "size": {
                    "px": 349
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": false,
                  "background": "chrome",
                  "border": {
                    "width": 2,
                    "color": "border"
                  }
                }
              ],
              "gap": 6
            },
            {
              "id": "statusbar-work",
              "type": "block",
              "content": {
                "mod": "whistle",
                "props": {
                  "bar": "Under the terminals",
                  "hintsLift": 15,
                  "hintsInset": 8,
                  "hintsBorder": 2
                }
              },
              "size": {
                "px": 26
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              },
              "resizable": false
            }
          ],
          "gap": 6,
          "resizable": false
        }
      ],
      "padding": 6,
      "gap": 6,
      "resizable": true
    },
    {
      "id": "statusbar",
      "type": "block",
      "content": {
        "mod": "whistle",
        "props": {
          "bar": "Full width",
          "enabled": false,
          "mappings": {
            "S": {
              "name": "Spaces",
              "map": {
                "r": ["Rename space", "mod.open:vectron-dialogs"]
              }
            },
            "/": [
              "Go to tab or space",
              "mod.open:vectron-dialog-picker"
            ],
            "s": [
              "Select Spaces",
              "whistle.field:spaces"
            ],
            "a": [
              "Select Agents",
              "whistle.field:agents"
            ],
            "e": [
              "Files panel",
              "whistle.focus:files"
            ],
            "E": [
              "Toggle files panel",
              "whistle.toggle:files"
            ],
            "g": [
              "Changes panel",
              "whistle.focus:changes"
            ],
            "G": [
              "Toggle changes panel",
              "whistle.toggle:changes"
            ],
            "p": [
              "Command palette",
              "mod.open:vectron-dialog-palette"
            ],
            ",": [
              "Settings",
              "mod.open:vectron-settings"
            ],
            "?": [
              "Keybindings",
              "mod.open:vectron-keys"
            ],
            "m": [
              "Mods",
              "mod.open:vectron-mod-manager"
            ]
          }
        }
      },
      "size": {
        "px": 22
      },
      "hidden": true,
      "background": "chrome",
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "vectron",
    "dark": "vectron"
  },
  "font": "CaskaydiaMono Nerd Font",
  "ui_font": "JetBrains Mono",
  "terminal_padding": [
    12,
    12
  ],
  "resizable": false,
  "traffic_lights": [
    12,
    8
  ],
  "preview": "layouts/vectron.png"
}
